{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TopSupport": ""
  },
  "App": {
    "BaseUrl": "https://topsupport.example"
  },
  "Email": {
    "Provider": "Ses",
    "FromAddress": "itsupport@topcashback.example",
    "FromName": "TopCashback IT Support",
    "Smtp": {
      "Host": "localhost",
      "Port": 2525,
      "UseStartTls": false
    }
  },
  "Dashboard": {
    "Port": 5280
  },
  "CloudWatch": {
    "Enabled": false,
    "Namespace": "TopSupport/Worker"
  },
  "Aws": {
    "Region": "",
    "ParameterStorePath": "/TopSupport/Worker"
  },
  "Jobs": {
    "TimeZone": "Europe/London",
    "TicketEventsCron": "* * * * *",
    "SlaSweepCron": "*/5 * * * *",
    "AutoCloseCron": "0 2 * * *",
    "DailyDigestCron": "0 8 * * 1-5",
    "HeartbeatCron": "*/5 * * * *",
    "FirstRunLookbackMinutes": 60,
    "EventOverlapMinutes": 5,
    "AutoCloseAfterDays": 7
  }
}

@page "/diagnostics"
@attribute [Authorize]
@inject TopSupportApiClient Api
@inject PageHeadingState Heading

<RoleGate AllowedRoles="new[] { AppRole.User, AppRole.Agent, AppRole.Admin }">
    <div class="card pad stack-16">
        <p>
            This page proves the Blazor Server app can reach TopSupport.Api over HTTP via a typed
            HttpClient (see TopSupport.Blazor/Services/TopSupportApiClient.cs), which in turn is
            the only thing standing between here and the ADO.NET/SQL Server tiers.
        </p>

        @if (_status is null && _error is null)
        {
            <p class="muted">Checking...</p>
        }
        else if (_error is not null)
        {
            <div class="err" role="alert">Could not reach the API: @_error</div>
        }
        else if (_status is not null)
        {
            <div class="notice" role="status">
                @((MarkupString)IconLibrary.Render("check", 18))
                <span>API responded: <strong>@_status.Status</strong> at @_status.Utc.ToString("u")</span>
            </div>
        }

        <button type="button" class="btn btn-secondary" @onclick="CheckHealthAsync">Check again</button>
    </div>
</RoleGate>

@code {
    private HealthStatus? _status;
    private string? _error;

    protected override void OnInitialized() => Heading.SetHeading("Diagnostics", "Confirms the Blazor -> API -> (future) SQL Server path is wired up.");

    protected override async Task OnInitializedAsync() => await CheckHealthAsync();

    private async Task CheckHealthAsync()
    {
        _status = null;
        _error = null;
        try
        {
            _status = await Api.GetHealthAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}

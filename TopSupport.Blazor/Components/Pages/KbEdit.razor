@page "/kb/{Id}/edit"
@using TopSupport.Models.Admin
@inject PageHeadingState Heading
@inject TopSupportApiClient Api
@inject SessionState Session
@inject ModalState Modal
@inject ToastState Toasts
@inject NavigationManager Nav

@* Port of PAGES.kbedit + ACT['ka-save'] / ACT['ka-del'] in topsupport-app.js. Id "new" creates
   an article; any other Id edits that article. Field ids follow fid('ka.<field>'). *@
<RoleGate AllowedRoles="new[] { AppRole.Admin }">
    @if (_kb is null)
    {
        <div class="card"><div class="empty"><span class="empty-icon">@((MarkupString)IconLibrary.Render("refresh", 26))</span><h3>Loading&hellip;</h3></div></div>
    }
    else if (!IsNew && _article is null)
    {
        <div class="card">
            <div class="empty">
                <span class="empty-icon">@((MarkupString)IconLibrary.Render("search", 26))</span>
                <h3>Article not found</h3>
                <p>It may have been deleted.</p>
                <button type="button" class="btn btn-secondary" @onclick="@(() => Nav.NavigateTo("/kb"))">Back to Knowledge Base</button>
            </div>
        </div>
    }
    else
    {
        <div class="side-col">
            <form class="card pad stack-16" novalidate aria-label="Article editor" @onsubmit:preventDefault="true">
                <div class="field">
                    <label class="field-label" for="f-ka-title">Title<span class="star" aria-hidden="true"> *</span></label>
                    <input class="input @(TitleError is null ? "" : "invalid")" id="f-ka-title" type="text" @bind="_title" @bind:event="oninput"
                           aria-required="true" aria-invalid="@(TitleError is null ? null : "true")" aria-describedby="@(TitleError is null ? null : "f-ka-title-e")" />
                    @if (TitleError is not null)
                    {
                        <span class="field-err" id="f-ka-title-e">@((MarkupString)IconLibrary.Render("alert", 14))@TitleError</span>
                    }
                </div>

                <div class="field-grid">
                    <div class="field">
                        <label class="field-label" for="f-ka-cat">Category</label>
                        <select class="input" id="f-ka-cat" @bind="_categoryId">
                            @foreach (var c in _kb.Categories)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label class="field-label" for="f-ka-status">Status</label>
                        <select class="input" id="f-ka-status" @bind="_status">
                            @foreach (var s in KbArticleStatuses.All)
                            {
                                <option value="@s">@s</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="field full">
                    <label class="field-label" for="f-ka-body">Article Text<span class="star" aria-hidden="true"> *</span></label>
                    <textarea class="input @(BodyError is null ? "" : "invalid")" id="f-ka-body" rows="12" @bind="_body" @bind:event="oninput"
                              aria-required="true" aria-invalid="@(BodyError is null ? null : "true")" aria-describedby="@(BodyError is null ? null : "f-ka-body-e")"></textarea>
                    @if (BodyError is not null)
                    {
                        <span class="field-err" id="f-ka-body-e">@((MarkupString)IconLibrary.Render("alert", 14))@BodyError</span>
                    }
                </div>

                <div class="row">
                    <button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
                        @((MarkupString)IconLibrary.Render("save", 16))Save Article
                    </button>
                    <button type="button" class="btn btn-secondary" @onclick="@(() => Nav.NavigateTo("/kb"))">Cancel</button>
                    @if (!IsNew)
                    {
                        <button type="button" class="btn btn-ghost" @onclick="ConfirmDelete">
                            @((MarkupString)IconLibrary.Render("trash", 16))Delete
                        </button>
                    }
                </div>
            </form>

            <aside class="card panel">
                <h2 class="panel-title">Writing Tips</h2>
                <p class="hint" style="line-height:1.6">Start with the task in the title, for example “Connect to the VPN”. Use short numbered steps and the exact names of buttons and menus.</p>
            </aside>
        </div>
    }
</RoleGate>

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private KnowledgeBaseDto? _kb;
    private KbArticleDto? _article;
    private string _title = string.Empty;
    private string _categoryId = string.Empty;
    private string _status = KbArticleStatuses.Draft;
    private string _body = string.Empty;
    private IReadOnlyDictionary<string, string> _errors = new Dictionary<string, string>();
    private bool _saving;

    private bool IsNew => Id == "new";
    private string? TitleError => _errors.GetValueOrDefault("title");
    private string? BodyError => _errors.GetValueOrDefault("body");

    protected override async Task OnParametersSetAsync()
    {
        Heading.SetHeading(IsNew ? "New article" : "Edit article", "Published articles appear on the help portal.");

        // PAGES.kbedit.init: load the article's values, or a blank Draft in the first category.
        _kb = await Api.GetKnowledgeBaseAsync();
        _article = IsNew ? null : _kb.Articles.FirstOrDefault(a => a.Id == Id);
        _title = _article?.Title ?? string.Empty;
        _categoryId = _article?.CategoryId ?? _kb.Categories.FirstOrDefault()?.Id ?? string.Empty;
        _status = _article?.Status ?? KbArticleStatuses.Draft;
        _body = _article?.Body ?? string.Empty;
        _errors = new Dictionary<string, string>();
    }

    private async Task SaveAsync()
    {
        var errors = new Dictionary<string, string>();
        if (string.IsNullOrWhiteSpace(_title)) errors["title"] = "Enter a title.";
        if (string.IsNullOrWhiteSpace(_body)) errors["body"] = "Write the article text.";
        _errors = errors;
        if (errors.Count > 0) return;

        _saving = true;
        try
        {
            var result = await Api.SaveKbArticleAsync(IsNew ? null : Id, new SaveKbArticleRequest
            {
                ActorId = Session.AccountId,
                Title = _title,
                CategoryId = _categoryId,
                Status = _status,
                Body = _body
            });

            if (result.Article is null)
            {
                _errors = result.Errors;
                // Category/status errors have no inline slot on this form (fixed selects), so surface them as a toast.
                var other = result.Errors.Where(e => e.Key is not ("title" or "body")).Select(e => e.Value).FirstOrDefault();
                if (other is not null) Toasts.Error(other);
                return;
            }

            Toasts.Show("Article saved.");
            Nav.NavigateTo("/kb");
        }
        finally
        {
            _saving = false;
        }
    }

    private void ConfirmDelete()
    {
        if (_article is null) return;
        Modal.Show(@<ConfirmModal Title="Delete Article?" Text="@($"“{_article.Title}” will be removed from the knowledge base.")"
                                  Label="Delete Article" Danger="true" OnConfirm="DeleteAsync" />);
    }

    private async Task DeleteAsync()
    {
        await Api.DeleteKbArticleAsync(Id);
        Toasts.Show("Article deleted.");
        Nav.NavigateTo("/kb");
    }
}

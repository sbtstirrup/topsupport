@page "/kb/{Id}/edit"
@inject PageHeadingState Heading

<RoleGate AllowedRoles="new[] { AppRole.Admin }">
    <ComingSoon Title="@(Id == "new" ? "New article" : "Edit article")" Icon="book" Message="The KB article editor (see PAGES.kbedit in the original demo) will be built out in a later pass." />
</RoleGate>

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    protected override void OnParametersSet() => Heading.SetHeading(Id == "new" ? "New article" : "Edit article", "Published articles appear on the help portal.");
}

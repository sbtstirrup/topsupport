@page "/agent-tickets/{Id}"
@attribute [Authorize(Roles = "Agent,Admin")]
@using TopSupport.Models.Enums
@using TopSupport.Models.Tickets
@using TopSupport.Models.Tickets.FieldSchema
@using TopSupport.Services.Tickets
@inject PageHeadingState Heading
@inject TopSupportApiClient Api
@inject LookupDataService Lookup
@inject SessionState Session
@inject ModalState ModalHost
@inject ToastState Toasts

@if (_loading)
{
    <div class="card"><div class="empty"><span class="empty-icon">@((MarkupString)IconLibrary.Render("refresh", 26))</span><h3>Loading&hellip;</h3></div></div>
}
else if (_ticket is null)
{
    <div class="card">
        <div class="empty">
            <span class="empty-icon">@((MarkupString)IconLibrary.Render("search", 26))</span>
            <h3>We could not find that ticket</h3>
            <p>It may have been deleted when the demo data was reset.</p>
            <a class="btn btn-primary" href="/queue/open">Open Queue</a>
        </div>
    </div>
}
else
{
    var t = _ticket;
    var mine = t.AssignedAgentId == Session.AccountId;
    // Resolved tickets still take replies and can be closed; only Closed ones must be reopened first.
    var closed = t.Status == TicketStatus.Closed;

    <div class="stack">
        @if (_flashMessage is not null)
        {
            <div class="notice" role="status">@((MarkupString)IconLibrary.Render("check", 18))<span><span class="notice-title">Done.</span> @_flashMessage</span></div>
        }

        <div class="card">
            <div class="tv-head">
                <div style="flex:1;min-width:220px">
                    <div class="tv-num">#@t.Number &middot; @TicketTopics.Find(t.Topic)?.Label &middot; @t.Department</div>
                    <h2>@t.Subject</h2>
                    <div class="row" style="margin-top:8px">
                        <StatusBadge Status="t.Status" />
                        <PriorityBadge Priority="t.Priority" />
                        @if (TicketSla.IsOverdue(t, DateTimeOffset.UtcNow))
                        {
                            <span class="tag overdue">@((MarkupString)IconLibrary.Render("clock", 13)) Overdue</span>
                        }
                        <span class="hint">Assigned to @AssigneeLabel(t)</span>
                    </div>
                </div>
                <div class="row">
                    <a class="btn btn-secondary btn-sm" href="/queue/open">@((MarkupString)IconLibrary.Render("back", 15))Queue</a>
                </div>
            </div>
            <div class="actionbar" role="toolbar" aria-label="Ticket actions" style="border-top:1px solid var(--line-4)">
                @if (!mine)
                {
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="ClaimAsync">@((MarkupString)IconLibrary.Render("user", 15))Claim</button>
                }
                <button type="button" class="btn btn-secondary btn-sm" @onclick="OpenAssign">@((MarkupString)IconLibrary.Render("users", 15))Assign</button>
                <button type="button" class="btn btn-secondary btn-sm" @onclick="OpenChange">@((MarkupString)IconLibrary.Render("edit", 15))Change Status, Priority or Topic</button>
                @if (!closed)
                {
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="OpenClose">@((MarkupString)IconLibrary.Render("lock", 15))Close</button>
                }
                else
                {
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="ReopenAsync">@((MarkupString)IconLibrary.Render("refresh", 15))Reopen</button>
                }
            </div>
        </div>

        <div class="stack">
            <TicketSummaryPanel Ticket="t" ForAgent="true" />

            <section class="card panel" aria-labelledby="tp-h">
                <h2 class="panel-title" id="tp-h">@TicketTopics.Find(t.Topic)?.Label Details</h2>
                @foreach (var d in _fieldSchema.Where(d => d.Type != TicketFieldType.Banner && (d.ShowWhen is null || d.ShowWhen.Evaluate(t.Fields))))
                {
                    <div class="kv">
                        <span>@d.Label.Replace(" (optional)", "", StringComparison.OrdinalIgnoreCase)</span>
                        <div>@AnswerText(d, t.Fields.GetValueOrDefault(d.Key))</div>
                    </div>
                }
            </section>

            @{ var deviceTag = t.Fields.GetValueOrDefault("device")?.ToString(); }
            @if (t.Topic == "hardware" && !string.IsNullOrWhiteSpace(deviceTag))
            {
                <DevicePanel AssetTag="@deviceTag"
                             CandidateTickets="_candidateTickets" ExcludeTicketId="@t.Id"
                             OnTicketClick="@(id => Nav.NavigateTo($"/agent-tickets/{id}"))" />
            }

            @if (!closed)
            {
                <section class="card pad-sm stack-16 reply-card @(_replyMode == "note" ? "note-mode" : "")" aria-labelledby="arp-h">
                    <div class="row between">
                        <h2 class="panel-title" id="arp-h" style="margin:0">Respond</h2>
                        <div class="tabs" role="tablist" aria-label="Response type">
                            <button type="button" class="tab" role="tab" aria-selected="@(_replyMode == "public")" @onclick="@(() => SetReplyMode("public"))">@((MarkupString)IconLibrary.Render("reply", 15))Public reply</button>
                            <button type="button" class="tab" role="tab" aria-selected="@(_replyMode == "note")" @onclick="@(() => SetReplyMode("note"))">@((MarkupString)IconLibrary.Render("lock", 15))Internal note</button>
                        </div>
                    </div>

                    @if (_replyMode == "note")
                    {
                        <div class="notice alert">@((MarkupString)IconLibrary.Render("lock", 18))<span>Internal notes are only visible to IT staff. The user is not told about them.</span></div>
                    }
                    else if (t.Status == TicketStatus.Resolved)
                    {
                        <div class="warn">@((MarkupString)IconLibrary.Render("info", 18))<span>This ticket is Resolved. Choose a status below if your reply should reopen it.</span></div>
                    }

                    @if (_cannedResponses.Count > 0)
                    {
                        <div class="field">
                            <label class="field-label" for="canned-select">Insert a canned response</label>
                            <select class="input" id="canned-select" @onchange="OnCannedSelected">
                                <option value="">Choose a response&hellip;</option>
                                @foreach (var c in _cannedResponses)
                                {
                                    <option value="@c.Id">@c.Title</option>
                                }
                            </select>
                            <span class="hint">Placeholders such as {recipient.name} are filled in for this ticket.</span>
                        </div>
                    }

                    <RichTextEditor @ref="_editorRef" @bind-Html="_replyHtml"
                                    Label="@(_replyMode == "note" ? "Internal note" : $"Reply to {RequesterName}")"
                                    Required="true" ErrorMessage="@_replyError"
                                    Placeholder="@(_replyMode == "note" ? "Notes for the team" : "Write your reply")" />

                    <FileUploadDropzone Label="Attachments (Optional)" Attachments="_replyFiles" AttachmentsChanged="OnReplyFilesChanged"
                                        OnUploadFile="StageReplyFileAsync" />

                    <div class="row" style="align-items:flex-end">
                        @if (_replyMode != "note")
                        {
                            <div class="field">
                                <label class="field-label" for="status-after">Status After Sending</label>
                                <select class="input" id="status-after" @bind="_statusAfterSending">
                                    <option value="">Keep as @EnumDisplay.Label(t.Status)</option>
                                    @foreach (var s in Enum.GetValues<TicketStatus>().Where(s => s != t.Status))
                                    {
                                        <option value="@s">Set to @EnumDisplay.Label(s)</option>
                                    }
                                </select>
                            </div>
                        }
                        <button type="button" class="btn btn-primary" @onclick="SendReplyAsync" disabled="@_sendingReply">
                            @((MarkupString)IconLibrary.Render(_replyMode == "note" ? "note" : "send", 16))@(_replyMode == "note" ? "Add Internal Note" : "Send Reply")
                        </button>
                        <button type="button" class="btn btn-ghost" @onclick="ClearReply">Clear</button>
                    </div>
                </section>
            }
            else
            {
                <div class="card pad-sm"><div class="notice">@((MarkupString)IconLibrary.Render("lock", 18))<span><span class="notice-title">This ticket is closed.</span> Reopen it to reply or add notes.</span></div></div>
            }

            <section class="card panel" aria-labelledby="atl-h">
                <h2 class="panel-title" id="atl-h"><span>Timeline</span><span class="hint">@(t.Timeline.Count(e => e.Kind == TicketTimelineEntryKind.Note)) internal notes</span></h2>
                <ol class="timeline" aria-label="Ticket timeline">
                    @foreach (var entry in t.Timeline.OrderBy(e => e.At))
                    {
                        @if (entry.Kind == TicketTimelineEntryKind.Event)
                        {
                            <li class="tl-event">
                                <span class="tl-dot">@((MarkupString)IconLibrary.Render(EventIcon(entry.Text), 15))</span>
                                <span>@entry.Text</span>
                                <time title="@entry.At.ToLocalTime().ToString("d MMM yyyy, HH:mm")">@entry.At.ToLocalTime().ToString("d MMM yyyy, HH:mm")</time>
                            </li>
                        }
                        else
                        {
                            var isAgent = entry.By.Type == "agent";
                            var isNote = entry.Kind == TicketTimelineEntryKind.Note;
                            var personName = ActorName(entry.By);
                            <li class="tl-msg">
                                <span class="avatar" aria-hidden="true">@NameFormat.Initials(personName)</span>
                                <article class="msg @(isNote ? "note" : (isAgent ? "" : "user"))" aria-label="@(isNote ? "Internal note" : "Message") from @personName">
                                    <header class="msg-head">
                                        <strong>@personName</strong>
                                        @if (isNote)
                                        {
                                            <span class="tag internal-tag">@((MarkupString)IconLibrary.Render("lock", 12, 2.5))Internal — not visible to user</span>
                                        }
                                        else if (isAgent)
                                        {
                                            <span class="tag tag-green">IT Support</span>
                                        }
                                        else
                                        {
                                            <span class="tag tag-grey">@(entry.By.Id == t.RequesterUserId ? "Requester" : "User")</span>
                                        }
                                        <time title="@entry.At.ToLocalTime().ToString("d MMM yyyy, HH:mm")">@entry.At.ToLocalTime().ToString("d MMM yyyy, HH:mm")</time>
                                    </header>
                                    <div class="msg-body">@((MarkupString)(entry.Html ?? ""))</div>
                                </article>
                            </li>
                        }
                    }
                </ol>
            </section>
        </div>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private TicketDto? _ticket;
    private bool _loading = true;
    private IReadOnlyList<TicketFieldDescriptor> _fieldSchema = Array.Empty<TicketFieldDescriptor>();
    private IReadOnlyList<CannedResponseDto> _cannedResponses = Array.Empty<CannedResponseDto>();
    private IReadOnlyList<TicketDto> _candidateTickets = Array.Empty<TicketDto>();
    private string? _flashMessage;

    private string _replyMode = "public";
    private string _replyHtml = "";
    private string? _replyError;
    private List<TopSupport.Blazor.Models.AttachmentRef> _replyFiles = new();
    private readonly List<TopSupport.Blazor.Models.StagedAttachment> _stagedReplyFiles = new();
    private string _statusAfterSending = "";
    private bool _sendingReply;
    private RichTextEditor? _editorRef;

    private string RequesterName => Lookup.FindUser(_ticket?.RequesterUserId)?.Name ?? "the requester";

    protected override void OnParametersSet() => Heading.SetHeading($"Ticket #{Id}");

    protected override async Task OnInitializedAsync()
    {
        await Lookup.GetUsersAsync();
        await Lookup.GetAgentsAsync();
        await Lookup.GetTeamsAsync();
        _cannedResponses = await Api.GetCannedResponsesAsync();
    }

    private string? _loadedId;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId != Id)
        {
            _loadedId = Id;
            await LoadTicketAsync();
        }
    }

    private async Task LoadTicketAsync()
    {
        _loading = true;
        StateHasChanged();

        _ticket = await Api.GetTicketAsync(Id);

        if (_ticket is not null)
        {
            // TicketDto.Fields is Dictionary<string, object?> and arrives from System.Text.Json
            // as raw JsonElement values (no custom converter registered) -- normalize to plain
            // CLR string/List<string> so ShowWhen.Evaluate and the read-only answer rendering
            // below (both written against ordinary CLR types) work correctly.
            _ticket.Fields = NormalizeFields(_ticket.Fields);

            _fieldSchema = await Api.GetFieldSchemaAsync(_ticket.Topic, _ticket.AffectedUserId);

            if (_ticket.Topic == "hardware")
            {
                // Best-effort cross-reference per DevicePanel's doc comment: use the open queue as
                // the candidate list (client-side filter-by-tag over whatever's already fetched).
                var queueResult = await Api.GetQueueAsync(new TicketQueueRequest { Queue = "open", PageSize = 100 });
                _candidateTickets = queueResult.Items.Select(t => { t.Fields = NormalizeFields(t.Fields); return t; }).ToList();
            }
        }

        _loading = false;
        StateHasChanged();
    }

    private static Dictionary<string, object?> NormalizeFields(Dictionary<string, object?> fields)
    {
        var result = new Dictionary<string, object?>();
        foreach (var (key, value) in fields)
        {
            result[key] = NormalizeValue(value);
        }
        return result;
    }

    private static object? NormalizeValue(object? value)
    {
        if (value is not System.Text.Json.JsonElement je) return value;

        return je.ValueKind switch
        {
            System.Text.Json.JsonValueKind.String => je.GetString(),
            System.Text.Json.JsonValueKind.True => true,
            System.Text.Json.JsonValueKind.False => false,
            System.Text.Json.JsonValueKind.Array => je.EnumerateArray().Select(x => x.ValueKind == System.Text.Json.JsonValueKind.String ? x.GetString() ?? "" : x.ToString()).ToList(),
            System.Text.Json.JsonValueKind.Null or System.Text.Json.JsonValueKind.Undefined => null,
            _ => je.ToString()
        };
    }

    private async Task ClaimAsync()
    {
        if (_ticket is null) return;
        try
        {
            await Api.ClaimTicketAsync(_ticket.Id);
            _flashMessage = $"You claimed #{_ticket.Number}.";
        }
        catch (HttpRequestException ex)
        {
            // 409: another agent claimed or reassigned it first -- the reload below shows who has it.
            Toasts.Error(ApiProblemException.UserMessage(ex));
        }
        await LoadTicketAsync();
    }

    private async Task ReopenAsync()
    {
        if (_ticket is null) return;
        try
        {
            await Api.ChangeStatusAsync(_ticket.Id, nameof(TicketStatus.Open));
            _flashMessage = $"#{_ticket.Number} reopened.";
            await LoadTicketAsync();
        }
        catch (HttpRequestException ex)
        {
            Toasts.Error(ApiProblemException.UserMessage(ex));
        }
    }

    private void OpenAssign()
    {
        if (_ticket is null) return;
        ModalHost.Show(@<AssignTicketModal TicketIds="new List<string> { _ticket.Id }" OnAssigned="@(() => HandleModalChanged("Assignment updated."))" />);
    }

    private void OpenChange()
    {
        if (_ticket is null) return;
        ModalHost.Show(@<ChangeTicketPropertiesModal TicketId="@_ticket.Id" Ticket="_ticket" OnSaved="@(() => HandleModalChanged("Ticket updated."))" />);
    }

    private void OpenClose()
    {
        if (_ticket is null) return;
        ModalHost.Show(@<CloseTicketModal TicketIds="new List<string> { _ticket.Id }" OnClosed="@(() => HandleModalChanged("Ticket closed."))" />);
    }

    private async Task HandleModalChanged(string message)
    {
        _flashMessage = message;
        await LoadTicketAsync();
    }

    private void SetReplyMode(string mode)
    {
        _replyMode = mode;
        _replyError = null;
    }

    private async Task OnCannedSelected(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        if (string.IsNullOrEmpty(id) || _ticket is null) return;

        var filled = await Api.PreviewCannedResponseAsync(id, _ticket.Id);
        if (_editorRef is not null)
        {
            // textToHTML(fillPlaceholders(...)): the body and filled-in values (e.g. the ticket subject) are plain text.
            await _editorRef.AppendHtmlAsync(HtmlText.FromText(filled));
        }
        _replyError = null;
    }

    /// <summary>
    /// Picked files are only staged (read into memory, nothing uploaded): they are uploaded after
    /// the reply/note is saved, anchored to its new timeline entry, so a file on an internal note
    /// is never visible to the requester. Removing a staged file just drops it.
    /// </summary>
    private async Task<TopSupport.Blazor.Models.AttachmentRef> StageReplyFileAsync(Microsoft.AspNetCore.Components.Forms.IBrowserFile file)
    {
        var staged = await TopSupport.Blazor.Models.StagedAttachment.ReadAsync(file);
        _stagedReplyFiles.Add(staged);
        return staged.Reference;
    }

    private void OnReplyFilesChanged(List<TopSupport.Blazor.Models.AttachmentRef> files)
    {
        _replyFiles = files;
        _stagedReplyFiles.RemoveAll(s => !files.Any(f => ReferenceEquals(f, s.Reference)));
    }

    /// <summary>Uploads the staged files anchored to <paramref name="timelineEntryId"/>; returns a message for any that failed.</summary>
    private async Task<string?> UploadStagedReplyFilesAsync(string ticketId, string? timelineEntryId)
    {
        var failed = new List<string>();
        foreach (var staged in _stagedReplyFiles.Where(s => _replyFiles.Any(f => ReferenceEquals(f, s.Reference))))
        {
            try
            {
                await Api.UploadAttachmentAsync(ticketId, staged, timelineEntryId);
            }
            catch (Exception ex) when (ex is HttpRequestException or IOException or TaskCanceledException)
            {
                failed.Add($"\"{staged.Reference.Name}\" ({ApiProblemException.FileUploadReason(ex)})");
            }
        }

        return failed.Count == 0 ? null : $" These files could not be attached: {string.Join(", ", failed)}.";
    }

    private async Task ClearReply()
    {
        _replyHtml = "";
        _replyError = null;
        _replyFiles = new();
        _stagedReplyFiles.Clear();
        _statusAfterSending = "";
        if (_editorRef is not null) await _editorRef.SetHtmlAsync("");
    }

    private async Task SendReplyAsync()
    {
        if (_ticket is null) return;

        var plainText = System.Text.RegularExpressions.Regex.Replace(_replyHtml ?? "", "<[^>]+>", "").Trim();
        if (string.IsNullOrEmpty(plainText) && !System.Text.RegularExpressions.Regex.IsMatch(_replyHtml ?? "", "<img|<table|<hr", System.Text.RegularExpressions.RegexOptions.IgnoreCase))
        {
            _replyError = _replyMode == "note" ? "Write the note before adding it." : "Write a reply before sending.";
            return;
        }

        _sendingReply = true;
        try
        {
            var request = new AddAgentReplyRequest
            {
                Html = _replyHtml ?? string.Empty,
                IsNote = _replyMode == "note",
                StatusAfterSending = _replyMode == "note" || string.IsNullOrEmpty(_statusAfterSending) ? null : _statusAfterSending
            };

            var updated = await Api.AddAgentReplyAsync(_ticket.Id, request);

            // The new entry is the newest Reply/Note by this agent; staged files are anchored to it.
            var entryId = updated.Timeline
                .Where(e => e.Kind is TicketTimelineEntryKind.Reply or TicketTimelineEntryKind.Note && e.By.Type == "agent" && e.By.Id == Session.AccountId)
                .MaxBy(e => e.At)?.Id;
            string? uploadProblem = null;
            if (_stagedReplyFiles.Count > 0)
            {
                uploadProblem = entryId is null ? " The files could not be attached." : await UploadStagedReplyFilesAsync(_ticket.Id, entryId);
            }

            _flashMessage = (_replyMode == "note" ? "Internal note added." : $"Reply sent to {RequesterName}.") + uploadProblem;
            await ClearReply();
            await LoadTicketAsync();
        }
        catch (HttpRequestException ex)
        {
            // e.g. the ticket was Closed meanwhile (400) or deleted (404): keep the draft so nothing is lost.
            Toasts.Error(ApiProblemException.UserMessage(ex));
        }
        finally
        {
            _sendingReply = false;
        }
    }

    private string AssigneeLabel(TicketDto t)
    {
        if (!string.IsNullOrEmpty(t.AssignedAgentId)) return Lookup.FindAgent(t.AssignedAgentId)?.Name ?? t.AssignedAgentId;
        if (!string.IsNullOrEmpty(t.AssignedTeamId)) return Lookup.FindTeam(t.AssignedTeamId)?.Name ?? t.AssignedTeamId;
        return "Unassigned";
    }

    private string ActorName(TicketActorRef by)
    {
        if (by.Type == "agent") return Lookup.FindAgent(by.Id)?.Name ?? "Unknown";
        if (by.Type == "user") return Lookup.FindUser(by.Id)?.Name ?? "Unknown";
        return "System";
    }

    private static string EventIcon(string? text)
    {
        if (string.IsNullOrEmpty(text)) return "clock";
        if (text.StartsWith("Created")) return "plus";
        if (text.StartsWith("Assigned") || text.StartsWith("Transferred")) return "user";
        if (text.StartsWith("Closed")) return "lock";
        if (text.StartsWith("Reopened")) return "refresh";
        if (text.Contains("Priority")) return "flag";
        if (text.Contains("ask") || text.Contains("Task")) return "task";
        return "clock";
    }

    private string AnswerText(TicketFieldDescriptor d, object? value)
    {
        // Values are pre-normalized to plain CLR types by NormalizeFields/NormalizeValue in
        // LoadTicketAsync (TicketDto.Fields otherwise arrives as raw JsonElement -- see there).
        if (value is null) return "Not answered";

        if (value is List<string> list)
        {
            if (list.Count == 0) return "Not answered";
            if (d.Type == TicketFieldType.Checks)
            {
                var labels = list.Select(v => d.StaticOptions?.FirstOrDefault(o => o.Value == v)?.Label ?? v);
                return string.Join(", ", labels);
            }
            // Files-type fields track attachments via TicketDto.Attachments, not a human-readable
            // Fields value -- a non-empty list here is just upload bookkeeping, not an answer to show.
            if (d.Type == TicketFieldType.Files) return "Not answered";
            return string.Join(", ", list);
        }

        if ((d.Type == TicketFieldType.Select || d.Type == TicketFieldType.Radio) && value is string sv)
        {
            if (string.IsNullOrEmpty(sv)) return "Not answered";
            return d.StaticOptions?.FirstOrDefault(o => o.Value == sv)?.Label ?? sv;
        }

        var text = value.ToString();
        return string.IsNullOrWhiteSpace(text) ? "Not answered" : text;
    }
}

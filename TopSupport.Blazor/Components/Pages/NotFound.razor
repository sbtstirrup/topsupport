@page "/not-found"
@layout Layout.EmptyLayout
@inject SessionState Session

@* Signed-in accounts get the app shell; anyone else the public chrome (not a Sign out button). *@
<LayoutView Layout="@(Session.IsSignedIn ? typeof(Layout.MainLayout) : typeof(Layout.PublicLayout))">
    <PageTitle>Not found - TopSupport</PageTitle>
    <h1>Not found</h1>
    <p>Sorry, the page you are looking for does not exist.</p>
</LayoutView>

@page "/not-found"
@layout Layout.PublicLayout

@* The public chrome for everyone: a 404 rendered by the status-code re-execute gets no antiforgery
   token, so the app shell's Sign out form couldn't work here anyway. /home sends a signed-in
   account to its own home page and anyone else to the landing page. *@
<PageTitle>Not found - TopSupport</PageTitle>
<div class="card pad stack-16" style="max-width:640px;margin:0 auto">
    <h1>Not found</h1>
    <p class="lede">Sorry, the page you are looking for does not exist.</p>
    <p><a class="btn btn-primary" href="home">Back to TopSupport</a></p>
</div>

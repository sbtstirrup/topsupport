@page "/raise"
@attribute [Authorize(Roles = "User")]
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using TopSupport.Blazor.Components.Shared
@using TopSupport.Blazor.Models
@using TopSupport.Models.Admin
@using TopSupport.Models.Enums
@using TopSupport.Models.People
@using TopSupport.Models.Tickets
@using TopSupport.Models.Tickets.FieldSchema
@inject PageHeadingState Heading
@inject SessionState Session
@inject LookupDataService Lookup
@inject TopSupportApiClient Api
@inject NavigationManager Nav
@inject ToastState Toasts

<RoleGate AllowedRoles="new[] { AppRole.User }">
    <div class="side-col">
        <form class="card pad stack-16" novalidate aria-describedby="raise-intro" @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
            <p class="lede" id="raise-intro" style="margin:0">Fields marked <span class="star">*</span> are required.</p>

            @if (_errorSummary.Count > 0)
            {
                <div class="err" role="alert" tabindex="-1">
                    <strong>@(_errorSummary.Count == 1 ? "Fix 1 thing before you continue" : $"Fix {_errorSummary.Count} things before you continue")</strong>
                    <ul>
                        @foreach (var msg in _errorSummary.Values)
                        {
                            <li>@msg</li>
                        }
                    </ul>
                </div>
            }

            <div class="field-grid">
                <div class="field">
                    <label class="field-label" for="raise-rname">Requester name</label>
                    <input class="input" id="raise-rname" readonly value="@(_requester?.Name ?? "")" />
                </div>
                <div class="field">
                    <label class="field-label" for="raise-remail">Requester email</label>
                    <input class="input" id="raise-remail" readonly value="@(_requester?.Email ?? "")" />
                </div>

                <div class="field full">
                    <label class="field-label" for="raise-topic">Help Topic<span class="star" aria-hidden="true"> *</span></label>
                    <span class="hint">The form below changes to match the topic you choose.</span>
                    <select class="input @(_errors.ContainsKey("topic") ? "invalid" : "")" id="raise-topic" value="@_topic" @onchange="OnTopicChangedAsync">
                        <option value="">Choose a help topic</option>
                        @foreach (var group in TopicGroups)
                        {
                            @if (string.IsNullOrEmpty(group.Label))
                            {
                                @foreach (var t in group.Items)
                                {
                                    <option value="@t.Id">@t.Label</option>
                                }
                            }
                            else
                            {
                                <optgroup label="@group.Label">
                                    @foreach (var t in group.Items)
                                    {
                                        <option value="@t.Id">@t.Label</option>
                                    }
                                </optgroup>
                            }
                        }
                    </select>
                    @if (_errors.TryGetValue("topic", out var topicErr))
                    {
                        <span class="field-err">@((MarkupString)IconLibrary.Render("alert", 14))@topicErr</span>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_topic))
            {
                <div class="field-grid">
                    <div class="field full">
                        <label class="field-label" for="raise-subject">Subject<span class="star" aria-hidden="true"> *</span></label>
                        <input class="input @(_errors.ContainsKey("subject") ? "invalid" : "")" id="raise-subject" type="text"
                               maxlength="@FieldLimits.TicketSubject"
                               value="@_subject" placeholder="A short summary, for example “Laptop will not charge”"
                               @onchange="@(e => _subject = e.Value?.ToString() ?? "")" />
                        @if (_errors.TryGetValue("subject", out var subjErr))
                        {
                            <span class="field-err">@((MarkupString)IconLibrary.Render("alert", 14))@subjErr</span>
                        }
                    </div>

                    <label class="full" style="display:flex;align-items:center;gap:8px;font-weight:600;cursor:pointer;margin-bottom:-6px">
                        <input type="checkbox" checked="@_affectedIsRequester" @onchange="OnAffectedIsRequesterChangedAsync"
                               style="width:18px;height:18px;margin:0;accent-color:var(--green)" />
                        Affected user is the requester@(_requester is not null ? $" ({_requester.Name})" : "")
                    </label>

                    @if (!_affectedIsRequester)
                    {
                        <PersonCombo Label="Affected User" Required="true" FullWidth="true"
                                     Hint="Defaults to the requester. Change it if you are asking for someone else."
                                     Value="@_affectedUserId" ValueChanged="OnAffectedChangedAsync"
                                     Pool="@_userPool" ErrorMessage="@(_errors.GetValueOrDefault("affected"))" />
                    }

                    @if (_affectedUser is not null)
                    {
                        <div class="readonly-details full" aria-label="Affected user details">
                            <div><span>Office</span><strong>@_affectedUser.Office</strong></div>
                            <div><span>Department</span><strong>@_affectedUser.Department</strong></div>
                            <div><span>Phone</span><strong>@_affectedUser.Phone</strong></div>
                        </div>
                    }

                    @foreach (var descriptor in _fieldSchema)
                    {
                        <DynamicTopicField Descriptor="descriptor"
                                            Value="@GetFieldValue(descriptor.Key)"
                                            ValueChanged="@(v => OnFieldChangedAsync(descriptor.Key, v))"
                                            AllValues="_fields"
                                            Errors="_errors"
                                            FullWidth="true"
                                            OnUploadFile="StageFileAsync" />
                    }
                </div>
            }
            else
            {
                <div class="notice">
                    @((MarkupString)IconLibrary.Render("info", 18))
                    <span>Choose a help topic to see the questions for it.</span>
                </div>
            }

            <div class="row" style="padding-top:6px;border-top:1px solid var(--line-4)">
                <button type="submit" class="btn btn-primary" disabled="@_isSubmitting">@((MarkupString)IconLibrary.Render("send", 16))Create Ticket</button>
                <button type="button" class="btn btn-secondary" @onclick="ResetForm">Reset</button>
            </div>
        </form>

        <TicketSummaryPanel PreviewMode="true"
                             PreviewTopic="@(string.IsNullOrEmpty(_topic) ? null : _topic)"
                             PreviewPriority="@PreviewPriority"
                             PreviewRequesterUserId="@Session.AccountId"
                             PreviewAffectedUserId="@_affectedUserId" />
    </div>
</RoleGate>

@code {
    private UserDto? _requester;
    private UserDto? _affectedUser;
    private IReadOnlyList<UserDto> _users = Array.Empty<UserDto>();
    private List<(string Id, string Name, string Meta)> _userPool = new();

    private IReadOnlyList<TicketTopic> _topics = Array.Empty<TicketTopic>();
    private string _topic = string.Empty;
    private string _subject = string.Empty;
    private bool _affectedIsRequester = true;
    private string? _affectedUserId;

    private List<TicketFieldDescriptor> _fieldSchema = new();
    private readonly Dictionary<string, object?> _fields = new();

    /// <summary>Files chosen before the ticket exists: staged locally (AttachmentRef.Id == null)
    /// and only actually uploaded once CreateTicketAsync succeeds and a ticket id exists.</summary>
    private readonly List<StagedAttachment> _stagedFiles = new();

    private Dictionary<string, string> _errors = new();
    private Dictionary<string, string> _errorSummary = new();
    private bool _isSubmitting;

    private record TopicGroup(string Label, List<TicketTopic> Items);

    private List<TopicGroup> TopicGroups => _topics
        .GroupBy(t => t.Group)
        .OrderBy(g => g.Key == "" ? 0 : g.Key == "Issues" ? 1 : 2)
        .Select(g => new TopicGroup(g.Key, g.ToList()))
        .ToList();

    private TicketPriority? PreviewPriority =>
        _fields.TryGetValue("impact", out var impact) && impact is string s && TicketFieldOptionSets.IMPACT_PRI.TryGetValue(s, out var pri)
            ? Enum.Parse<TicketPriority>(pri)
            : TicketPriority.Normal;

    protected override void OnInitialized() => Heading.SetHeading("Raise a Ticket", "Tell us what is wrong and we will pick it up.");

    protected override async Task OnInitializedAsync()
    {
        _topics = await Api.GetTopicsAsync();
        _users = await Lookup.GetUsersAsync();
        _requester = _users.FirstOrDefault(u => u.Id == Session.AccountId);
        _affectedUserId = Session.AccountId;
        _affectedUser = _requester;
        _userPool = _users.Select(u => (u.Id, u.Name, Meta: $"{u.Department} · {u.Email}")).ToList();
    }

    private object? GetFieldValue(string key) => _fields.TryGetValue(key, out var v) ? v : null;

    private async Task OnTopicChangedAsync(ChangeEventArgs e)
    {
        _topic = e.Value?.ToString() ?? string.Empty;
        _fields.Clear();
        _errors.Clear();
        _errorSummary.Clear();
        await LoadFieldSchemaAsync();
    }

    private async Task LoadFieldSchemaAsync()
    {
        if (string.IsNullOrEmpty(_topic))
        {
            _fieldSchema = new();
            return;
        }

        _fieldSchema = (await Api.GetFieldSchemaAsync(_topic, _affectedUserId)).ToList();
    }

    private async Task OnAffectedIsRequesterChangedAsync(ChangeEventArgs e)
    {
        _affectedIsRequester = (bool)(e.Value ?? false);
        _affectedUserId = _affectedIsRequester ? Session.AccountId : null;
        _affectedUser = _affectedIsRequester ? _requester : null;
        await LoadFieldSchemaAsync();
    }

    private async Task OnAffectedChangedAsync(string? userId)
    {
        _affectedUserId = userId;
        _affectedUser = _users.FirstOrDefault(u => u.Id == userId);
        await LoadFieldSchemaAsync();
    }

    private async Task OnFieldChangedAsync(string key, object? value)
    {
        _fields[key] = value;
        // Some fields' option lists / visibility depend on sibling answers (e.g. hardware's
        // "device" depends on "deviceType") -- re-resolve against the server so dynamic
        // option sources stay accurate, then re-render.
        if (!string.IsNullOrEmpty(_topic))
        {
            await LoadFieldSchemaAsync();
        }
    }

    private async Task<AttachmentRef> StageFileAsync(IBrowserFile file)
    {
        // Read now: the browser file can't be read later once the input changes again.
        var staged = await StagedAttachment.ReadAsync(file);
        _stagedFiles.Add(staged);
        return staged.Reference;
    }

    /// <summary>Staged files still listed in a Files-type field (one removed before submitting is never uploaded).</summary>
    private IEnumerable<StagedAttachment> StagedFilesToUpload()
    {
        var kept = _fields.Values.OfType<List<AttachmentRef>>().SelectMany(list => list).ToList();
        return _stagedFiles.Where(s => kept.Any(k => ReferenceEquals(k, s.Reference)));
    }

    private void ResetForm()
    {
        _topic = string.Empty;
        _subject = string.Empty;
        _affectedIsRequester = true;
        _affectedUserId = Session.AccountId;
        _affectedUser = _requester;
        _fields.Clear();
        _stagedFiles.Clear();
        _fieldSchema.Clear();
        _errors.Clear();
        _errorSummary.Clear();
    }

    private async Task SubmitAsync()
    {
        if (_isSubmitting) return;
        _isSubmitting = true;
        try
        {
            var fields = new Dictionary<string, object?>(_fields);
            // Attachments are staged, not yet uploaded -- don't send file refs as a field value.
            fields.Remove("attachments");

            var request = new CreateTicketRequest
            {
                Topic = _topic,
                Subject = _subject.Trim(),
                RequesterUserId = Session.AccountId,
                AffectedUserId = _affectedUserId ?? string.Empty,
                Fields = fields
            };

            var createdBy = new TicketActorRef { Type = "user", Id = Session.AccountId };
            var response = await Api.CreateTicketRawAsync(request, createdBy);

            if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                await ApplyValidationErrorsAsync(response);
                return;
            }

            response.EnsureSuccessStatusCode();
            var ticket = (await response.Content.ReadFromJsonAsync<TicketDto>())!;

            // The ticket exists now: a failed upload must still open it (with a toast), never leave
            // the form up for a resubmit that would raise a duplicate ticket.
            var failed = new List<string>();
            foreach (var staged in StagedFilesToUpload())
            {
                try
                {
                    await Api.UploadAttachmentAsync(ticket.Id, staged, "user", Session.AccountId);
                }
                catch (Exception ex) when (ex is HttpRequestException or IOException or TaskCanceledException)
                {
                    failed.Add($"\"{staged.Reference.Name}\" ({ex.Message})");
                }
            }

            if (failed.Count > 0)
            {
                Toasts.Show($"Ticket #{ticket.Number} was raised, but these files could not be attached: {string.Join(", ", failed)}.", isError: true);
            }

            Nav.NavigateTo($"/tickets/{ticket.Id}?created=1");
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task ApplyValidationErrorsAsync(HttpResponseMessage response)
    {
        var problem = await response.Content.ReadFromJsonAsync<ValidationProblemBody>();
        _errors = new Dictionary<string, string>();
        _errorSummary = new Dictionary<string, string>();
        if (problem?.Errors is not null)
        {
            foreach (var (key, messages) in problem.Errors)
            {
                var message = messages.FirstOrDefault() ?? "Invalid value.";
                _errors[key] = message;
                _errorSummary[key] = message;
            }
        }
    }

    private record ValidationProblemBody(Dictionary<string, string[]>? Errors);
}

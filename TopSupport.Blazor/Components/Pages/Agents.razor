@page "/agents"
@attribute [Authorize(Roles = "Admin")]
@using TopSupport.Models.Admin
@using TopSupport.Models.People
@inject PageHeadingState Heading
@inject TopSupportApiClient Api
@inject ModalState Modal
@inject ToastState Toasts
@inject LookupDataService Lookup
@inject NavigationManager Nav

@* Port of PAGES.agents in topsupport-app.js: Agents tab (table) and Teams tab (cards), with
   create/edit modals for both, team delete and (beyond the demo's agents page, reusing
   ACT['user-reset']) an agent password reset. ?tab=teams mirrors the demo's p.tab. *@
<RoleGate AllowedRoles="new[] { AppRole.Admin }">
    @if (_agents is null || _teams is null)
    {
        <p class="hint">Loading…</p>
    }
    else
    {
        <div class="stack">
            <div class="row between">
                <div class="tabs" role="tablist" aria-label="Agents or teams">
                    <button type="button" class="tab" role="tab" aria-selected="@(!IsTeamsTab ? "true" : "false")" @onclick="@(() => Nav.NavigateTo("/agents"))">Agents<span class="count">@_agents.Count</span></button>
                    <button type="button" class="tab" role="tab" aria-selected="@(IsTeamsTab ? "true" : "false")" @onclick="@(() => Nav.NavigateTo("/agents?tab=teams"))">Teams<span class="count">@_teams.Count</span></button>
                </div>
                @if (IsTeamsTab)
                {
                    <button type="button" class="btn btn-primary" @onclick="@(() => EditTeam(null))">@((MarkupString)IconLibrary.Render("plus", 16))Create Team</button>
                }
                else
                {
                    <button type="button" class="btn btn-primary" @onclick="@(() => EditAgent(null))">@((MarkupString)IconLibrary.Render("plus", 16))Create Agent</button>
                }
            </div>

            @if (IsTeamsTab)
            {
                <div class="two-col">
                    @foreach (var t in _teams)
                    {
                        var lead = FindAgent(t.LeadAgentId);
                        <section class="card pad-sm stack-8" aria-labelledby="tm-@t.Id">
                            <div class="row between">
                                <h2 id="tm-@t.Id" class="card-title" style="margin:0">@t.Name</h2>
                                <button type="button" class="btn btn-ghost btn-sm" @onclick="@(() => EditTeam(t))">@((MarkupString)IconLibrary.Render("edit", 14))Edit</button>
                            </div>
                            <span class="hint">@t.Department · lead @(string.IsNullOrEmpty(t.LeadAgentId) ? "not set" : lead?.Name)</span>
                            @if (t.MemberAgentIds.Count > 0)
                            {
                                @foreach (var a in MembersInOrder(t))
                                {
                                    <div class="list-item">
                                        <span class="avatar agent" aria-hidden="true">@Initials(a.Name)</span>
                                        <span style="flex:1"><strong style="font-size:14px">@a.Name</strong><span class="cell-sub">@a.JobTitle</span></span>
                                        @if (t.LeadAgentId == a.Id)
                                        {
                                            <span class="tag tag-green">Lead</span>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="hint">No members yet.</p>
                            }
                            <span class="hint">@_counts.ByTeam.GetValueOrDefault(t.Id) active tickets assigned to this team</span>
                        </section>
                    }
                </div>
            }
            else
            {
                <section class="card">
                    <div class="tbl-wrap">
                        <table class="tbl">
                            <caption class="sr-only">Agents</caption>
                            <thead>
                                <tr><th><span>Name</span></th><th><span>Role</span></th><th><span>Departments</span></th><th><span>Teams</span></th><th><span>Active tickets</span></th><th><span>Status</span></th><th><span>Actions</span></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var a in _agents)
                                {
                                    var teamNames = a.TeamIds.Select(id => FindTeam(id)?.Name ?? string.Empty).ToList();
                                    <tr>
                                        <td class="who"><strong>@a.Name</strong><span class="cell-sub">@a.Email · @a.Phone</span></td>
                                        <td><span class="tag @RoleTagClass(a.Role)">@a.Role</span></td>
                                        <td>@LinesOf(a.Departments)</td>
                                        <td>
                                            @if (teamNames.Count > 0)
                                            {
                                                @LinesOf(teamNames)
                                            }
                                            else
                                            {
                                                <span class="muted">None</span>
                                            }
                                        </td>
                                        <td class="num-tab">@_counts.ByAgent.GetValueOrDefault(a.Id)</td>
                                        <td>
                                            @if (a.Active)
                                            {
                                                <span class="tag tag-green">Active</span>
                                            }
                                            else
                                            {
                                                <span class="tag tag-grey">Inactive</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="row" style="flex-wrap:nowrap;gap:6px">
                                                <button type="button" class="icon-btn" aria-label="Edit @a.Name" @onclick="@(() => EditAgent(a))">@((MarkupString)IconLibrary.Render("edit", 16))</button>
                                                <button type="button" class="icon-btn" aria-label="Reset password for @a.Name" @onclick="@(() => ConfirmReset(a))">@((MarkupString)IconLibrary.Render("key", 16))</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }
        </div>
    }
</RoleGate>

@code {
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    private IReadOnlyList<AgentDto>? _agents;
    private IReadOnlyList<TeamDto>? _teams;
    private ActiveTicketCountsDto _counts = new();

    private bool IsTeamsTab => Tab == "teams";

    protected override void OnInitialized() => Heading.SetHeading("Agents and Teams", "IT staff, their departments and roles, and the teams they belong to.");

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var agents = Api.GetAdminAgentsAsync();
        var teams = Api.GetAdminTeamsAsync();
        var counts = Api.GetAgentTeamActiveTicketCountsAsync();
        await Task.WhenAll(agents, teams, counts);
        _agents = agents.Result;
        _teams = teams.Result;
        _counts = counts.Result;
    }

    /// <summary>Reloads this page and refreshes the cached agent/team pools the ticket screens use.</summary>
    private async Task ReloadAfterChangeAsync()
    {
        await LoadAsync();
        await Lookup.GetAgentsAsync(forceRefresh: true);
        await Lookup.GetTeamsAsync(forceRefresh: true);
        StateHasChanged();
    }

    private AgentDto? FindAgent(string? id) => _agents?.FirstOrDefault(a => a.Id == id);
    private TeamDto? FindTeam(string? id) => _teams?.FirstOrDefault(t => t.Id == id);

    // Members in DB.agents order (the demo keeps team.members in the order agents were ticked;
    // TeamMembers rows have no order, so agent order is the closest stable equivalent).
    private IEnumerable<AgentDto> MembersInOrder(TeamDto team)
        => _agents!.Where(a => team.MemberAgentIds.Contains(a.Id));

    private static string RoleTagClass(string role) => role switch
    {
        AgentRoles.Administrator => "tag-red",
        AgentRoles.Supervisor => "tag-amber",
        _ => "tag-grey"
    };

    private static string Initials(string name)
        => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0])).ToUpperInvariant();

    // Equivalent of the demo's values.map(esc).join('<br>').
    private static RenderFragment LinesOf(IReadOnlyList<string> values) => __builder =>
    {
        for (var i = 0; i < values.Count; i++)
        {
            if (i > 0)
            {
                <br />
            }
            <text>@values[i]</text>
        }
    };

    private void EditAgent(AgentDto? agent)
        => Modal.Show(@<AgentEditModal Agent="agent" Teams="_teams!" OnSaved="OnAgentSavedAsync" />, wide: true);

    private async Task OnAgentSavedAsync(AgentAdminSaveResult result)
    {
        await ReloadAfterChangeAsync();
        Toasts.Show(result.Name + " saved.");

        // A new agent's temporary password is shown once (the demo's create flow generates one
        // silently; showing it follows the Create User flow so the agent can actually sign in).
        if (result.TemporaryPassword is not null)
        {
            var created = FindAgent(result.Id);
            Modal.Show(@<AgentTempPasswordModal Name="@result.Name" Username="@(created?.Username ?? string.Empty)" Password="@result.TemporaryPassword" />);
        }
    }

    private void ConfirmReset(AgentDto agent)
        => Modal.Show(@<ConfirmModal Title="Reset Password?"
                                     Text="@($"{agent.Name} will need a temporary password to sign in. Their current password stops working straight away.")"
                                     Label="Reset Password"
                                     OnConfirm="@(() => ResetAsync(agent))" />);

    private async Task ResetAsync(AgentDto agent)
    {
        var result = await Api.ResetAgentPasswordAsync(agent.Id);
        await ReloadAfterChangeAsync();
        Modal.Show(@<AgentTempPasswordModal Name="@result.Name" Username="@result.Username" Password="@result.TemporaryPassword" />);
    }

    private void EditTeam(TeamDto? team)
        => Modal.Show(@<TeamEditModal Team="team" Agents="_agents!" OnSaved="OnTeamSavedAsync" OnDelete="@(() => DeleteTeamAsync(team!))" />);

    private async Task OnTeamSavedAsync(AgentAdminSaveResult result)
    {
        await ReloadAfterChangeAsync();
        Toasts.Show(result.Name + " saved.");
    }

    // ACT['team-del']: refuse while tickets still point at the team (modal stays open), otherwise confirm.
    private async Task DeleteTeamAsync(TeamDto team)
    {
        var check = await Api.CheckTeamDeleteAsync(team.Id);
        if (check.Error is not null)
        {
            Toasts.Error(check.Error);
            return;
        }

        Modal.Show(@<ConfirmModal Title="@("Delete " + team.Name + "?")"
                                  Text="Members stay as agents but leave this team."
                                  Label="Delete Team"
                                  Danger="true"
                                  OnConfirm="@(() => ConfirmDeleteTeamAsync(team))" />);
    }

    private async Task ConfirmDeleteTeamAsync(TeamDto team)
    {
        var result = await Api.DeleteTeamAsync(team.Id);
        if (result.Error is not null)
        {
            Toasts.Error(result.Error);
            return;
        }

        await ReloadAfterChangeAsync();
        Toasts.Show("Team deleted.");
    }
}

@page "/site"
@attribute [Authorize(Roles = "Admin")]
@using TopSupport.Models.Admin
@inject PageHeadingState Heading
@inject TopSupportApiClient Api
@inject ToastState Toasts
@inject NavigationManager Nav

@* Port of PAGES.site / ACT['site-save'] in topsupport-app.js. Landing.razor and SignIn.razor read
   the saved text through SiteText. *@
@if (_form is not null)
{
    <div class="two-col">
        <section class="card pad stack-16" aria-labelledby="sl-h">
            <h2 id="sl-h" class="card-title" style="margin:0">Landing Page</h2>
            <div class="field">
                <label class="field-label" for="f-site-landingTitle">Welcome Heading</label>
                <input class="input @Invalid("landingTitle")" id="f-site-landingTitle" type="text" maxlength="@FieldLimits.SiteHeading" @bind="_form.LandingTitle" @bind:event="oninput" />
                @FieldError("landingTitle")
            </div>
            <div class="field full">
                <label class="field-label" for="f-site-landingBody">Welcome Message</label>
                <textarea class="input @Invalid("landingBody")" id="f-site-landingBody" rows="4" maxlength="@FieldLimits.SiteBody" @bind="_form.LandingBody" @bind:event="oninput"></textarea>
                @FieldError("landingBody")
            </div>
            <p class="hint">The “Raise a ticket” button, sign-in button and login help line always appear.</p>
        </section>
        <section class="card pad stack-16" aria-labelledby="ssi-h">
            <h2 id="ssi-h" class="card-title" style="margin:0">Sign-In Page</h2>
            <div class="field">
                <label class="field-label" for="f-site-signinTitle">Heading</label>
                <input class="input @Invalid("signinTitle")" id="f-site-signinTitle" type="text" maxlength="@FieldLimits.SiteHeading" @bind="_form.SigninTitle" @bind:event="oninput" />
                @FieldError("signinTitle")
            </div>
            <div class="field full">
                <label class="field-label" for="f-site-signinBody">Instructions</label>
                <textarea class="input @Invalid("signinBody")" id="f-site-signinBody" rows="3" maxlength="@FieldLimits.SiteBody" @bind="_form.SigninBody" @bind:event="oninput"></textarea>
                @FieldError("signinBody")
            </div>
        </section>
        <div class="row full">
            <button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
                @((MarkupString)IconLibrary.Render("save", 16))Save Pages
            </button>
            <button type="button" class="btn btn-secondary" @onclick="@(() => Nav.NavigateTo("/"))">
                @((MarkupString)IconLibrary.Render("eye", 16))View Landing Page
            </button>
        </div>
    </div>
}

@code {
    // S.forms.site: an editable copy of the saved text.
    private SiteSettingsDto? _form;
    private IReadOnlyDictionary<string, string> _errors = new Dictionary<string, string>();
    private bool _saving;

    protected override void OnInitialized() => Heading.SetHeading("Site Pages", "Text on the public landing page and the sign-in page.");

    protected override async Task OnInitializedAsync() => _form = await Api.GetSiteSettingsAsync();

    private string Invalid(string key) => _errors.ContainsKey(key) ? "invalid" : "";

    private RenderFragment FieldError(string key) => __builder =>
    {
        if (_errors.TryGetValue(key, out var error))
        {
            <span class="field-err">@((MarkupString)IconLibrary.Render("alert", 14))@error</span>
        }
    };

    private async Task SaveAsync()
    {
        if (_form is null) return;

        // The Api validates the text: field errors show inline, "Headings cannot be empty." (key "") as a toast.
        _errors = new Dictionary<string, string>();
        _saving = true;
        try
        {
            _errors = await Api.SaveSiteSettingsAsync(_form);
            if (_errors.Count > 0)
            {
                if (_errors.GetValueOrDefault("") is { } general) Toasts.Error(general);
                return;
            }
            Toasts.Show("Site pages saved.");
        }
        catch (HttpRequestException ex)
        {
            Toasts.Error(ApiProblemException.UserMessage(ex));
        }
        finally
        {
            _saving = false;
        }
    }
}

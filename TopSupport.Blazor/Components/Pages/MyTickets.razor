@page "/my-tickets"
@attribute [Authorize(Roles = "User")]
@using TopSupport.Blazor.Components.Shared
@using TopSupport.Models.Enums
@using TopSupport.Models.People
@using TopSupport.Models.Tickets
@using TopSupport.Models.Tickets.FieldSchema
@inject PageHeadingState Heading
@inject SessionState Session
@inject LookupDataService Lookup
@inject TopSupportApiClient Api
@inject NavigationManager Nav

<RoleGate AllowedRoles="new[] { AppRole.User }">
    @if (!_loaded)
    {
        <div class="card"><div class="empty"><p>Loading your tickets&hellip;</p></div></div>
    }
    else if (_all.Count == 0)
    {
        <div class="card">
            <div class="empty">
                <span class="empty-icon">@((MarkupString)IconLibrary.Render("ticket", 26))</span>
                <h3>You haven't raised any tickets yet</h3>
                <p>When you raise a ticket, or someone raises one for you, it appears here.</p>
                <button type="button" class="btn btn-primary" @onclick="@(() => Nav.NavigateTo("/raise"))">
                    @((MarkupString)IconLibrary.Render("plus", 16))Raise a Ticket
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="stack">
            <div class="row between">
                <div class="tabs" role="tablist" aria-label="Ticket status">
                    @foreach (var tab in new[] { "open", "closed" })
                    {
                        <button type="button" class="tab" role="tab" aria-selected="@(_tab == tab)" @onclick="@(() => SetTab(tab))">
                            @(tab == "open" ? "Open" : "Closed")<span class="count">@(tab == "open" ? OpenCount : ClosedCount)</span>
                        </button>
                    }
                </div>
                <button type="button" class="btn btn-primary" @onclick="@(() => Nav.NavigateTo("/raise"))">
                    @((MarkupString)IconLibrary.Render("plus", 16))Raise a Ticket
                </button>
            </div>

            <section class="card" aria-label="Tickets">
                <div class="filters">
                    <div class="field grow">
                        <label class="field-label" for="mt-q">Search</label>
                        <div class="search">
                            @((MarkupString)IconLibrary.Render("search", 16))
                            <input class="input" id="mt-q" type="search" value="@_search" placeholder="Ticket number, subject or details"
                                   @oninput="OnSearchChanged" />
                        </div>
                    </div>
                    <div class="field">
                        <label class="field-label" for="mt-topic">Help Topic</label>
                        <select class="input" id="mt-topic" value="@(_topicFilter ?? "")" @onchange="OnTopicFilterChanged">
                            <option value="">All topics (@TabRows.Count)</option>
                            @foreach (var t in _topics)
                            {
                                <option value="@t.Id">@t.Label (@TabRows.Count(x => x.Topic == t.Id))</option>
                            }
                        </select>
                    </div>
                    @if (HasActiveFilters)
                    {
                        <button type="button" class="btn btn-ghost" @onclick="ClearFilters">
                            @((MarkupString)IconLibrary.Render("x", 16))Clear All Filters
                        </button>
                    }
                </div>

                @if (FilteredRows.Count == 0)
                {
                    <div class="empty">
                        <span class="empty-icon">@((MarkupString)IconLibrary.Render("search", 26))</span>
                        <h3>No tickets match your filters</h3>
                        <p>Try a different word or topic, or clear the filters.</p>
                        <button type="button" class="btn btn-secondary" @onclick="ClearFilters">Clear Filters</button>
                    </div>
                }
                else
                {
                    <QueueTable Tickets="PageRows" TotalCount="FilteredRows.Count" ColumnSet="QueueTableColumnSet.User"
                                SortKey="@_sortKey" SortKeyChanged="OnSortKeyChanged"
                                SortDirection="@_sortDir" SortDirectionChanged="OnSortDirChanged"
                                PageNumber="_page" PageNumberChanged="OnPageChanged" PageSize="_pageSize"
                                OnRowClick="@(id => Nav.NavigateTo($"/tickets/{id}"))"
                                ActorNameResolver="@ResolveActorName" TeamNameResolver="@ResolveTeamName" />
                }
            </section>
        </div>
    }
</RoleGate>

@code {
    private bool _loaded;
    private IReadOnlyList<TicketDto> _all = Array.Empty<TicketDto>();
    private IReadOnlyList<TicketTopic> _topics = Array.Empty<TicketTopic>();

    private string _tab = "open";
    private string _search = string.Empty;
    private string? _topicFilter;
    private string _sortKey = "created";
    private string _sortDir = "desc";
    private int _page = 1;
    private readonly int _pageSize = 10;

    private static readonly TicketStatus[] OpenStatuses = { TicketStatus.Open, TicketStatus.InProgress, TicketStatus.AwaitingUser };

    protected override void OnInitialized() => Heading.SetHeading("My Tickets", "Tickets you raised and tickets raised for you.");

    protected override async Task OnInitializedAsync()
    {
        _all = await Api.GetMyTicketsAsync(Session.AccountId);
        _topics = await Api.GetTopicsAsync();
        await Lookup.GetUsersAsync();
        await Lookup.GetAgentsAsync();
        await Lookup.GetTeamsAsync();
        _loaded = true;
    }

    private bool IsOpenTicket(TicketDto t) => OpenStatuses.Contains(t.Status);

    private int OpenCount => _all.Count(t => IsOpenTicket(t) && (_topicFilter is null || t.Topic == _topicFilter) && MatchesSearch(t));
    private int ClosedCount => _all.Count(t => !IsOpenTicket(t) && (_topicFilter is null || t.Topic == _topicFilter) && MatchesSearch(t));

    /// <summary>All rows for the current tab, matching search but NOT the topic filter --
    /// used to compute the per-topic counts shown in the topic <select>.</summary>
    private List<TicketDto> TabRows => _all.Where(t => (_tab == "open") == IsOpenTicket(t) && MatchesSearch(t)).ToList();

    private bool HasActiveFilters => !string.IsNullOrWhiteSpace(_search) || _topicFilter is not null;

    private bool MatchesSearch(TicketDto t)
    {
        if (string.IsNullOrWhiteSpace(_search)) return true;
        var q = _search.Trim();
        var haystack = string.Join(' ', new[] { "#" + t.Number, t.Number, t.Subject }
            .Concat(t.Fields.Values.Select(FieldValueAsSearchableText).Where(s => !string.IsNullOrEmpty(s))));
        return haystack.Contains(q, StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>Fields deserialize as System.Text.Json.JsonElement (Dictionary&lt;string, object?&gt;
    /// has no custom converter), so a plain `v is string` check never matches -- only string-kind
    /// scalar values are searched, matching the JS demo's `typeof v === 'string'` filter.</summary>
    private static string FieldValueAsSearchableText(object? value) => value switch
    {
        string s => s,
        System.Text.Json.JsonElement { ValueKind: System.Text.Json.JsonValueKind.String } je => je.GetString() ?? string.Empty,
        _ => string.Empty
    };

    private List<TicketDto> FilteredRows => TabRows.Where(t => _topicFilter is null || t.Topic == _topicFilter).ToList();

    private List<TicketDto> SortedRows
    {
        get
        {
            Func<TicketDto, IComparable> key = _sortKey switch
            {
                "num" => t => t.Number,
                "status" => t => (int)t.Status,
                "subject" => t => t.Subject.ToLowerInvariant(),
                "topic" => t => TicketTopics.Find(t.Topic)?.Label ?? t.Topic,
                "created" => t => t.Created,
                _ => t => t.Created
            };
            var ordered = _sortDir == "asc" ? FilteredRows.OrderBy(key) : FilteredRows.OrderByDescending(key);
            return ordered.ToList();
        }
    }

    private List<TicketDto> PageRows
    {
        get
        {
            var totalPages = Math.Max(1, (int)Math.Ceiling(SortedRows.Count / (double)_pageSize));
            if (_page > totalPages) _page = totalPages;
            return SortedRows.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();
        }
    }

    private void SetTab(string tab)
    {
        _tab = tab;
        _page = 1;
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        _page = 1;
    }

    private void OnTopicFilterChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        _topicFilter = string.IsNullOrEmpty(value) ? null : value;
        _page = 1;
    }

    private void ClearFilters()
    {
        _search = string.Empty;
        _topicFilter = null;
        _page = 1;
    }

    private Task OnSortKeyChanged(string? key)
    {
        _sortKey = key ?? "created";
        _page = 1;
        return Task.CompletedTask;
    }

    private Task OnSortDirChanged(string dir)
    {
        _sortDir = dir;
        return Task.CompletedTask;
    }

    private Task OnPageChanged(int page)
    {
        _page = page;
        return Task.CompletedTask;
    }

    private string ResolveActorName(string? id)
    {
        if (string.IsNullOrEmpty(id)) return "—";
        return Lookup.FindUser(id)?.Name ?? Lookup.FindAgent(id)?.Name ?? id;
    }

    private string ResolveTeamName(string? id)
    {
        if (string.IsNullOrEmpty(id)) return "—";
        return Lookup.FindTeam(id)?.Name ?? id;
    }
}

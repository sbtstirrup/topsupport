@* Contenteditable rich-text editor, matching rte()/ACT.rte in topsupport-app.js: .rte/.rte-bar/
   .rte-area markup, toolbar buttons for Bold/Italic/Underline/Strikethrough/Bulleted-list/
   Numbered-list/Link via document.execCommand. Two-way bindable via @bind-Html.

   Usage: <RichTextEditor @bind-Html="F.Body" Label="Reply" Required="true" />
   To append text without overwriting (e.g. inserting a canned response), call AppendHtmlAsync
   on a @ref to this component instead of setting Html directly. *@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="field full">
    <span class="field-label" id="@_labelId">@Label@(Required ? StarMarkup : null)</span>
    <div class="rte @(string.IsNullOrEmpty(ErrorMessage) ? "" : "invalid")">
        <div class="rte-bar" role="toolbar" aria-label="Formatting">
            <button type="button" aria-label="Bold" title="Bold" @onclick="@(() => ExecCommand("bold"))">@((MarkupString)IconLibrary.Render("bold"))</button>
            <button type="button" aria-label="Italic" title="Italic" @onclick="@(() => ExecCommand("italic"))">@((MarkupString)IconLibrary.Render("italic"))</button>
            <button type="button" aria-label="Underline" title="Underline" @onclick="@(() => ExecCommand("underline"))">@((MarkupString)IconLibrary.Render("underline"))</button>
            <button type="button" aria-label="Strikethrough" title="Strikethrough" @onclick="@(() => ExecCommand("strikeThrough"))">@((MarkupString)IconLibrary.Render("strike"))</button>
            <span class="sep"></span>
            <button type="button" aria-label="Bulleted list" title="Bulleted list" @onclick="@(() => ExecCommand("insertUnorderedList"))">@((MarkupString)IconLibrary.Render("ul"))</button>
            <button type="button" aria-label="Numbered list" title="Numbered list" @onclick="@(() => ExecCommand("insertOrderedList"))">@((MarkupString)IconLibrary.Render("ol"))</button>
            <span class="sep"></span>
            <button type="button" aria-label="Insert link" title="Insert link" @onclick="@(() => ExecCommand("link"))">@((MarkupString)IconLibrary.Render("link"))</button>
        </div>
        <div class="rte-area" id="@_id" @ref="_editorRef" contenteditable="true" role="textbox" aria-multiline="true"
             aria-labelledby="@_labelId" data-placeholder="@(Placeholder ?? "Write your message")"></div>
    </div>
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <span class="field-err">@((MarkupString)IconLibrary.Render("alert", 14))@ErrorMessage</span>
    }
</div>

@code {
    private static readonly MarkupString StarMarkup = (MarkupString)"<span class=\"star\" aria-hidden=\"true\"> *</span>";

    [Parameter] public string Html { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> HtmlChanged { get; set; }
    [Parameter] public string Label { get; set; } = "Message";
    [Parameter] public bool Required { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }

    private readonly string _id = "rte-" + Guid.NewGuid().ToString("N");
    private string _labelId => _id + "-lbl";
    private ElementReference _editorRef;
    private IJSObjectReference? _module;
    private DotNetObjectReference<RichTextEditor>? _selfRef;
    private string _lastKnownHtml = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Shared/RichTextEditor.razor.js");
            _selfRef = DotNetObjectReference.Create(this);
            _lastKnownHtml = Html;
            await _module.InvokeVoidAsync("initEditor", _editorRef, _selfRef, Html);
        }
    }

    /// <summary>Appends HTML to the end of the current content rather than replacing it --
    /// used for inserting a canned response without wiping what the agent already typed.</summary>
    public async Task AppendHtmlAsync(string html)
    {
        if (_module is null) return;
        await _module.InvokeVoidAsync("appendHtml", _editorRef, html);
        var newHtml = await _module.InvokeAsync<string>("getHtml", _editorRef);
        _lastKnownHtml = newHtml;
        Html = newHtml;
        await HtmlChanged.InvokeAsync(newHtml);
    }

    /// <summary>Replaces the editor's content (e.g. clearing it after a reply is sent).</summary>
    public async Task SetHtmlAsync(string html)
    {
        if (_module is null) return;
        await _module.InvokeVoidAsync("setHtml", _editorRef, html);
        _lastKnownHtml = html;
        Html = html;
        await HtmlChanged.InvokeAsync(html);
    }

    private async Task ExecCommand(string command)
    {
        if (_module is null) return;
        await _module.InvokeVoidAsync("execCommand", _editorRef, command, null);
        var newHtml = await _module.InvokeAsync<string>("getHtml", _editorRef);
        if (newHtml != _lastKnownHtml)
        {
            _lastKnownHtml = newHtml;
            Html = newHtml;
            await HtmlChanged.InvokeAsync(newHtml);
        }
    }

    [JSInvokable]
    public async Task OnContentChanged(string html)
    {
        _lastKnownHtml = html;
        Html = html;
        await HtmlChanged.InvokeAsync(html);
    }

    public async ValueTask DisposeAsync()
    {
        _selfRef?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("destroy", _editorRef);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}

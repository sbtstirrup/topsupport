@* Port of MODALS.temppw / ACT['copy-pw'] in topsupport-app.js, used by the Agents and Teams page
   after creating an agent or resetting an agent's password. Renders only the inner content --
   ModalHost.razor supplies the .modal-back/.modal chrome. *@
@inject ModalState Modal
@inject ToastState Toasts
@inject IJSRuntime JS

<div class="modal-head">
    <h2>Temporary Password</h2>
    <button type="button" class="icon-btn" aria-label="Close dialog" @onclick="Modal.Close">@((MarkupString)IconLibrary.Render("x", 18))</button>
</div>
<div class="modal-body">
    <p style="font-size:14px">Give this password to <strong>@Name</strong> in person or by phone. They should change it from My profile after signing in.</p>
    <div class="temp-pw" aria-label="Temporary password">@Password</div>
    <p class="hint">Username: <code>@Username</code>. This password is shown once.</p>
</div>
<div class="modal-foot">
    <button type="button" class="btn btn-secondary" @onclick="CopyAsync">@((MarkupString)FileIcon)Copy</button>
    <button type="button" class="btn btn-primary" @onclick="Modal.Close">Done</button>
</div>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Username { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Password { get; set; } = string.Empty;

    // The demo's ic('file', 16); not in IconLibrary, so inlined here rather than editing the shared map.
    private const string FileIcon = "<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M6 2h8l5 5v15H6z\"/><path d=\"M14 2v5h5\"/></svg>";

    private async Task CopyAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Password);
            Toasts.Show("Password copied.");
        }
        catch (JSException)
        {
            Toasts.Error("Copy was blocked. Select the password and copy it.");
        }
    }
}

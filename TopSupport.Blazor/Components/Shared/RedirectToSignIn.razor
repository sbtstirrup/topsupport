@* allowed(pg) in topsupport-app.js for pages the account can't see: signed out -> the sign-in page,
   coming back here afterwards (the demo's S.params.next); signed in with the wrong role -> that
   role's home. forceLoad: the sign-in page is static (see SignIn.razor). *@
@inject NavigationManager Nav
@inject SessionState Session

@code {
    protected override void OnInitialized()
    {
        if (!Session.IsSignedIn)
        {
            Nav.NavigateTo("/signin?returnUrl=" + Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri)), forceLoad: true);
        }
        else
        {
            Nav.NavigateTo(Session.HomeRoute());
        }
    }
}

@* Generic per-topic field renderer, switching on TicketFieldDescriptor.Type -- mirrors
   renderTopicField() in topsupport-app.js so no topic's form is ever hand-coded. Used by the
   Raise (end user) and NewTicket (agent) forms.

   Value is two-way bound (object?): Text/TextArea/Select/Radio/Date carry a string, Checks
   carries a List<string>, Files carries a List<AttachmentRef> (via the composed
   FileUploadDropzone -- OnUploadFile must be supplied by the caller when any Files-type field
   is in play). AllValues is the full current answer set (Key -> Value) for ShowWhen evaluation
   -- the composing form must keep this up to date (e.g. a Dictionary<string, object?> rebuilt
   or mutated on every field change) and pass the SAME instance/fresh copy down on each render
   so conditional fields re-evaluate correctly as sibling answers change.

   Renders nothing (no wrapper element at all) when Descriptor.ShowWhen evaluates false. *@
@using TopSupport.Blazor.Models
@using TopSupport.Models.Admin
@using TopSupport.Models.Tickets.FieldSchema

@if (ShouldShow)
{
    @switch (Descriptor.Type)
    {
        case TicketFieldType.Text:
            <div class="field @(FullWidth ? "full" : "")">
                <label class="field-label" for="@_id">@Descriptor.Label@StarIfRequired</label>
                @if (!string.IsNullOrEmpty(Descriptor.Hint))
                {
                    <span class="hint">@Descriptor.Hint</span>
                }
                <input class="input @(HasError ? "invalid" : "")" id="@_id" type="text" maxlength="@FieldLimits.TopicText"
                       value="@AsString(Value)" placeholder="@Descriptor.Placeholder"
                       @onchange="@(e => SetValue(e.Value?.ToString()))" />
                @ErrorMarkup
            </div>
            break;

        case TicketFieldType.TextArea:
            <div class="field full">
                <label class="field-label" for="@_id">@Descriptor.Label@StarIfRequired</label>
                @if (!string.IsNullOrEmpty(Descriptor.Hint))
                {
                    <span class="hint">@Descriptor.Hint</span>
                }
                <textarea class="input @(HasError ? "invalid" : "")" id="@_id" rows="@(Descriptor.Rows ?? 4)" maxlength="@FieldLimits.TopicTextArea"
                          placeholder="@Descriptor.Placeholder"
                          @onchange="@(e => SetValue(e.Value?.ToString()))">@AsString(Value)</textarea>
                @ErrorMarkup
            </div>
            break;

        case TicketFieldType.Select:
            <div class="field @(FullWidth ? "full" : "")">
                <label class="field-label" for="@_id">@Descriptor.Label@StarIfRequired</label>
                @if (!string.IsNullOrEmpty(Descriptor.Hint))
                {
                    <span class="hint">@Descriptor.Hint</span>
                }
                <select class="input @(HasError ? "invalid" : "")" id="@_id"
                        value="@AsString(Value)" @onchange="@(e => SetValue(e.Value?.ToString()))">
                    <option value="">Choose&hellip;</option>
                    @foreach (var opt in Descriptor.StaticOptions ?? new())
                    {
                        <option value="@opt.Value">@opt.Label</option>
                    }
                </select>
                @ErrorMarkup
            </div>
            break;

        case TicketFieldType.Radio:
            <fieldset class="full">
                <legend>@Descriptor.Label@StarIfRequired</legend>
                @if (!string.IsNullOrEmpty(Descriptor.Hint))
                {
                    <span class="hint">@Descriptor.Hint</span>
                }
                <div class="choice-list @(HasError ? "invalid" : "")">
                    @foreach (var opt in Descriptor.StaticOptions ?? new())
                    {
                        var isOn = AsString(Value) == opt.Value;
                        <label class="choice @(isOn ? "on" : "")">
                            <input type="radio" name="@_id" checked="@isOn" @onchange="@(() => SetValue(opt.Value))" />
                            <span>
                                <span class="choice-title">@opt.Label</span>
                                @if (!string.IsNullOrEmpty(opt.Description))
                                {
                                    <span class="choice-desc">@opt.Description</span>
                                }
                            </span>
                        </label>
                    }
                </div>
                @ErrorMarkup
            </fieldset>
            break;

        case TicketFieldType.Checks:
            var options = Descriptor.StaticOptions ?? new();
            <fieldset class="full">
                <legend>@Descriptor.Label@StarIfRequired</legend>
                @if (!string.IsNullOrEmpty(Descriptor.Hint))
                {
                    <span class="hint">@Descriptor.Hint</span>
                }
                @if (options.Count > 0)
                {
                    <div class="chips">
                        @foreach (var opt in options)
                        {
                            var isOn = SelectedValues.Contains(opt.Value);
                            <label class="chip @(isOn ? "on" : "")">
                                <input type="checkbox" checked="@isOn" @onchange="@(e => ToggleCheck(opt.Value, (bool)(e.Value ?? false)))" />
                                @opt.Label
                            </label>
                        }
                    </div>
                }
                else
                {
                    <span class="hint">@(Descriptor.EmptyMessage ?? "Nothing to choose from.")</span>
                }
                @ErrorMarkup
            </fieldset>
            break;

        case TicketFieldType.Date:
            <div class="field">
                <label class="field-label" for="@_id">@Descriptor.Label@StarIfRequired</label>
                @if (!string.IsNullOrEmpty(Descriptor.Hint))
                {
                    <span class="hint">@Descriptor.Hint</span>
                }
                <input class="input @(HasError ? "invalid" : "")" id="@_id" type="date"
                       value="@AsString(Value)" @onchange="@(e => SetValue(e.Value?.ToString()))" />
                @ErrorMarkup
            </div>
            break;

        case TicketFieldType.Files:
            <FileUploadDropzone Label="@Descriptor.Label"
                                 Hint="@Descriptor.Hint"
                                 Attachments="FilesValue"
                                 AttachmentsChanged="OnFilesChanged"
                                 OnUploadFile="OnUploadFile!" />
            break;

        case TicketFieldType.Banner:
            <div class="warn full">
                @((MarkupString)IconLibrary.Render("phone"))
                <span>@(Descriptor.Hint ?? Descriptor.Label) If this is stopping you working right now, also call the Service Desk on ext. 4400.</span>
            </div>
            break;
    }
}

@code {
    [Parameter, EditorRequired] public TicketFieldDescriptor Descriptor { get; set; } = null!;
    [Parameter] public object? Value { get; set; }
    [Parameter] public EventCallback<object?> ValueChanged { get; set; }
    [Parameter] public IReadOnlyDictionary<string, object?> AllValues { get; set; } = new Dictionary<string, object?>();
    [Parameter] public IReadOnlyDictionary<string, string> Errors { get; set; } = new Dictionary<string, string>();

    /// <summary>Only used when Descriptor.Type == Files -- required if any Files-type field is rendered.</summary>
    [Parameter] public Func<Microsoft.AspNetCore.Components.Forms.IBrowserFile, Task<AttachmentRef>>? OnUploadFile { get; set; }

    /// <summary>Whether Text/Select fields span the full form-grid width (default: follow the
    /// field grid's 2-column layout like the demo's .field without .full).</summary>
    [Parameter] public bool FullWidth { get; set; }

    private string _id => "f-" + Descriptor.Key;

    private bool ShouldShow => Descriptor.ShowWhen is null || Descriptor.ShowWhen.Evaluate(AllValues);

    private bool HasError => Errors.ContainsKey(Descriptor.Key);

    private RenderFragment ErrorMarkup => builder =>
    {
        if (Errors.TryGetValue(Descriptor.Key, out var message))
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "field-err");
            builder.AddContent(2, (MarkupString)IconLibrary.Render("alert", 14));
            builder.AddContent(3, message);
            builder.CloseElement();
        }
    };

    private List<string> SelectedValues => Value as List<string> ?? new();

    private List<AttachmentRef> FilesValue => Value as List<AttachmentRef> ?? new();

    private static string AsString(object? value) => value?.ToString() ?? string.Empty;

    private Task SetValue(string? value) => ValueChanged.InvokeAsync(value);

    private Task ToggleCheck(string value, bool isChecked)
    {
        var list = new List<string>(SelectedValues);
        if (isChecked) { if (!list.Contains(value)) list.Add(value); }
        else { list.Remove(value); }
        return ValueChanged.InvokeAsync(list);
    }

    private Task OnFilesChanged(List<AttachmentRef> files) => ValueChanged.InvokeAsync(files);

    private MarkupString StarIfRequired => Descriptor.Required
        ? (MarkupString)"<span class=\"star\" aria-hidden=\"true\"> *</span>"
        : (MarkupString)string.Empty;
}

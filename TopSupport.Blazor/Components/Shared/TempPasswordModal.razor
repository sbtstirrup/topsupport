@* Port of MODALS.temppw (+ ACT['copy-pw']) in topsupport-app.js: shows a new temporary password
   once, after creating a user or resetting their password. Renders only the inner content --
   ModalHost.razor supplies the .modal-back/.modal chrome. *@
@using TopSupport.Models.Admin
@inject ModalState Modal
@inject ToastState Toasts
@inject IJSRuntime JS

<div class="modal-head">
    <h2>Temporary Password</h2>
    <button type="button" class="icon-btn" aria-label="Close dialog" @onclick="Modal.Close">@((MarkupString)IconLibrary.Render("x", 18))</button>
</div>
<div class="modal-body">
    <p style="font-size:14px">Give this password to <strong>@Password.Name</strong> in person or by phone. They should change it from My profile after signing in.</p>
    <div class="temp-pw" aria-label="Temporary password">@Password.Password</div>
    <p class="hint">Username: <code>@Password.Username</code>. This password is shown once.</p>
</div>
<div class="modal-foot">
    @* The demo uses a 'file' icon, which IconLibrary doesn't have; 'page' is the closest match. *@
    <button type="button" class="btn btn-secondary" @onclick="CopyAsync">@((MarkupString)IconLibrary.Render("page", 16))Copy</button>
    <button type="button" class="btn btn-primary" @onclick="Modal.Close">Done</button>
</div>

@code {
    [Parameter, EditorRequired] public TemporaryPasswordDto Password { get; set; } = new();

    private async Task CopyAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Password.Password);
            Toasts.Show("Password copied.");
        }
        catch (JSException)
        {
            Toasts.Error("Copy was blocked. Select the password and copy it.");
        }
    }
}

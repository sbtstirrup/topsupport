@* Port of allowed(pg) in topsupport-app.js: redirects to /signin (coming back here afterwards,
   the demo's S.params.next) if nobody is signed in, or to the role's home route if the signed-in
   role isn't one of AllowedRoles. UI only -- the Api enforces the same roles on every call.
   Wrap each role-restricted page's content in this. *@
@implements IDisposable
@inject SessionState Session
@inject NavigationManager Nav

@if (IsAllowed)
{
    @ChildContent
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter, EditorRequired] public AppRole[] AllowedRoles { get; set; } = Array.Empty<AppRole>();

    private bool IsAllowed { get; set; }

    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
        Evaluate();
    }

    protected override void OnParametersSet() => Evaluate();

    private void OnSessionChanged()
    {
        Evaluate();
        StateHasChanged();
    }

    private void Evaluate()
    {
        if (Session.Role is not { } role)
        {
            IsAllowed = false;
            // forceLoad: the sign-in page is static (see SignIn.razor), so it needs a real page load.
            Nav.NavigateTo("/signin?returnUrl=" + Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri)), forceLoad: true);
            return;
        }

        IsAllowed = AllowedRoles.Contains(role);
        if (!IsAllowed)
        {
            Nav.NavigateTo(Session.HomeRoute());
        }
    }

    public void Dispose() => Session.Changed -= OnSessionChanged;
}

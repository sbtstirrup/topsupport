@inherits LayoutComponentBase
@inject SessionState Session
@inject NavProvider NavProvider
@inject PageHeadingState Heading
@inject NavigationManager Nav
@inject TopSupportApiClient Api
@using TopSupport.Models.Admin

<a class="skip" href="#main">Skip to content</a>
<div class="app">
    <aside class="sidebar" aria-label="Main navigation">
        <div class="brand">
            <div class="brand-icon">@((MarkupString)BrandIcon)</div>
            <div>
                <div class="brand-title">TopSupport</div>
                <div class="brand-sub">@PortalLabel()</div>
            </div>
        </div>
        <nav class="nav">
            @foreach (var row in _navRows)
            {
                @if (row.GroupLabel is not null)
                {
                    <div class="nav-group">@row.GroupLabel</div>
                }
                else if (row.Item is not null)
                {
                    var isActive = IsActive(row.Item.Route);
                    <button type="button" class="nav-btn @(isActive ? "active" : "")"
                            aria-current="@(isActive ? "page" : null)"
                            @onclick="() => Nav.NavigateTo(row.Item.Route)">
                        @((MarkupString)IconLibrary.Render(row.Item.Icon))
                        <span class="lbl">@row.Item.Label</span>
                        @if (row.Item.Count.HasValue)
                        {
                            <span class="nav-count @(row.Item.CountIsAlert && row.Item.Count.Value > 0 ? "alert" : "")">@row.Item.Count.Value</span>
                        }
                    </button>
                }
            }
        </nav>
        <div class="side-foot">
            <button type="button" class="side-link" @onclick="@(() => Nav.NavigateTo("/diagnostics"))">
                @((MarkupString)IconLibrary.Render("refresh"))
                <span>Diagnostics</span>
            </button>
            <button type="button" class="side-link" @onclick="SignOut">
                @((MarkupString)IconLibrary.Render("logout"))
                <span>Sign out</span>
            </button>
        </div>
    </aside>
    <main class="main" id="main">
        <header class="topbar">
            <div class="topbar-title">
                <h1>@Heading.Title</h1>
                @if (!string.IsNullOrEmpty(Heading.Description))
                {
                    <p>@Heading.Description</p>
                }
            </div>
            <div class="topbar-right">
                <div class="role-switch">
                    <label for="role-switch">Viewing as</label>
                    <select class="input" id="role-switch" value="@(Session.Role?.ToString() ?? "")" @onchange="OnRoleChanged">
                        @if (!Session.IsSignedIn)
                        {
                            <option value="">Signed out</option>
                        }
                        <option value="User">End user</option>
                        <option value="Agent">Agent</option>
                        <option value="Admin">Admin</option>
                    </select>
                </div>
                @if (Session.IsSignedIn)
                {
                    <div class="rel acct-wrap">
                        <button type="button" class="acct" aria-haspopup="true" aria-expanded="@_acctMenu" @onclick="() => _acctMenu = !_acctMenu"><span class="avatar" aria-hidden="true">@Initials(Session.DisplayName)</span><span class="acct-name">@Session.DisplayName</span></button>
                        @if (_acctMenu)
                        {
                            @* Account menu from the demo's acct-menu (My profile is the only route to /profile for agents and admins). *@
                            <div class="menu-pop" role="menu">
                                <div class="menu-meta"><strong style="color:var(--ink);font-size:14px">@Session.DisplayName</strong><br />@PortalLabel()</div>
                                <button type="button" role="menuitem" @onclick="GoToProfile">My profile</button>
                                <button type="button" role="menuitem" @onclick="SignOut">Sign out</button>
                            </div>
                        }
                    </div>
                }
            </div>
        </header>
        <div class="stripe"></div>
        <div class="content">
            @Body
        </div>
    </main>
</div>

@if (Session.IsSignedIn)
{
    <ModalHost />
    <ToastHost />
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private const string BrandIcon = "<svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M8 20h8M12 16v4\"/><path d=\"m9 10 2 2 4-4\"/></svg>";

    private IReadOnlyList<NavRow> _navRows = Array.Empty<NavRow>();
    private bool _acctMenu;

    private void GoToProfile()
    {
        _acctMenu = false;
        Nav.NavigateTo("/profile");
    }

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        Heading.Changed += StateHasChanged;
        await RefreshNavAsync();
    }

    private void OnSessionChanged()
    {
        StateHasChanged();
        _ = InvokeAsync(RefreshNavAsync);
    }

    private async Task RefreshNavAsync()
    {
        _navRows = Session.Role is { } role
            ? await NavProvider.GetNavRowsAsync(role, Session.AccountId)
            : Array.Empty<NavRow>();
        await InvokeAsync(StateHasChanged);
    }

    private string PortalLabel() => Session.Role switch
    {
        AppRole.User => "Help portal",
        AppRole.Admin => "Admin console",
        AppRole.Agent => "Agent workspace",
        _ => "Sign in"
    };

    private bool IsActive(string route) => Nav.Uri.EndsWith(route, StringComparison.OrdinalIgnoreCase);

    private async Task OnRoleChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        if (string.IsNullOrEmpty(value))
        {
            await SignOut();
            return;
        }

        var role = Enum.Parse<AppRole>(value);
        Session.SetRole(role);
        // setRole(role) in the demo: audited as the newly selected account.
        await Api.LogAuditAsync(Session.AccountId, $"Switched role to {RoleLabel(role)} (demo override)", "Role switcher", AuditCategories.SignIn);
        Nav.NavigateTo(Session.HomeRoute());
    }

    private async Task SignOut()
    {
        _acctMenu = false;
        // ACT.signout: audited before the session is cleared, as the account signing out.
        if (Session.Role is { } role)
        {
            await Api.LogAuditAsync(Session.AccountId, "Signed out", role == AppRole.User ? "User portal" : "Agent portal", AuditCategories.SignIn);
        }

        Session.SetRole(null);
        Nav.NavigateTo("/");
    }

    /// <summary>ROLE_LABEL in topsupport-app.js.</summary>
    private static string RoleLabel(AppRole role) => role switch
    {
        AppRole.User => "End user",
        AppRole.Agent => "Agent",
        _ => "Admin"
    };

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Take(2).Select(p => char.ToUpperInvariant(p[0])));
    }
}

@inherits LayoutComponentBase
@inject NavigationManager Nav

@* Matches pubShell() in topsupport-app.js: the unauthenticated chrome used by the landing
   and sign-in pages. Links rather than @onclick buttons, because the sign-in page renders
   statically (no interactivity). *@
<a class="skip" href="#pub-main">Skip to content</a>
<div class="pub">
    <header class="pub-top">
        <a class="brand" href="" style="color:inherit;text-decoration:none">
            <div class="brand-icon">@((MarkupString)BrandIcon)</div>
            <div>
                <div class="brand-title">TopSupport</div>
                <div class="brand-sub">TopCashback</div>
            </div>
        </a>
        <div class="topbar-right">
            @if (!IsSignInPage)
            {
                <a class="btn btn-secondary btn-sm" href="signin">Sign in</a>
            }
        </div>
    </header>
    <main class="pub-body" id="pub-main">
        @Body
    </main>
</div>

@code {
    private const string BrandIcon = "<svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M8 20h8M12 16v4\"/><path d=\"m9 10 2 2 4-4\"/></svg>";

    private bool IsSignInPage => Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Equals("signin", StringComparison.OrdinalIgnoreCase);
}
